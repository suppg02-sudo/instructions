{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "description": "Enhance Claude Memory menu domain options — hub-spoke from global-config.json",
  "updated": "2026-04-08",
  "static": [
    {
      "id": "claudeclaudemd",
      "label": "`~/.claude/CLAUDE.md`",
