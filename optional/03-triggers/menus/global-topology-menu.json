{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "description": "Topology menu domain options — hub-spoke from global-config.json",
  "updated": "2026-08-10",
  "static": [
    {
      "id": "topology-status",
      "label": "`topology status`",
      "description": "repo/git state + device count"
    },
    {
      "id": "topology-list",
      "label": "`topology list`",
      "description": "every device + role + up/??"
    },
    {
      "id": "topology-show-device",
      "label": "`topology show [device]`",
